# Nova Poshta API key (do not commit real key to git)
NOVA_POSHTA_API_KEY=your_api_key_here

# Local payments: demo (no bank requests) or sandbox
PAYMENT_MODE=demo
# Only a TEST token from https://api.monobank.ua/ — never a live acquiring token
MONOBANK_TEST_TOKEN=

# Order total in UAH (default 400)
NEXT_PUBLIC_ORDER_AMOUNT_UAH=400

# Telegram order notifications (server only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Managed Redis for deployed orders (server only)
KV_REST_API_URL=
KV_REST_API_TOKEN=
APP_URL=
TELEGRAM_CHAT_IDS=
